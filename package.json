    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.0.8"
